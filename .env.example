# ─────────────────────────────────────────────────────────────────────────────
# KILN environment
#
# Copy to `.env` if you want to override anything. You do not have to.
# With this file absent entirely, KILN boots into full offline mode:
#   - an embedded Postgres 16 (PGlite) under .kiln/pgdata
#   - the `mock` model provider driven by fixtures/model/
#   - every connector routed to its simulated twin
#   - a file-backed dev KMS under .kiln/keys
# `pnpm install && pnpm db:push && pnpm seed && pnpm dev` must work with zero
# values set. That is a hard acceptance criterion, not a convenience.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_URL=http://localhost:3000
ENCRYPTION_MASTER_KEY=

# ── Database ────────────────────────────────────────────────────────────────
# Unset  -> embedded PGlite at .kiln/pgdata (no Docker, no network).
# Set    -> any Postgres 16 connection string (docker-compose, Supabase, ...).
# PGlite admits one process, so the embedded database is a web-only environment:
# no worker, so nothing executes a run. Set KILN_ALLOW_EMBEDDED=1 to accept that
# from `pnpm bootstrap`; without it bootstrap fails rather than exiting 0 with
# half a stack.
# DATABASE_URL=postgresql://kiln:kiln@localhost:5432/kiln
# KILN_PGDATA=.kiln/pgdata
# PGPOOL_MAX=10
# KILN_ALLOW_EMBEDDED=1

# ── Model gateway ───────────────────────────────────────────────────────────
# Providers are resolved left to right; the chain always ends at `mock` so a
# run degrades instead of failing. Leave as-is to run entirely on fixtures.
MODEL_PROVIDER=mock
MODEL_FALLBACK_ORDER=mock

# Moonshot / Kimi. Model ids are NEVER hardcoded in the source; they come from
# MODEL_TIER_MAP below. Fill in whatever ids are current for your account.
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_DEFAULT_MODEL=
# KIMI_MODEL_DEEP=
# KIMI_MODEL_FAST=

# DeepSeek.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_DEFAULT_MODEL=
# DEEPSEEK_MODEL_DEEP=
# DEEPSEEK_MODEL_FAST=

# Maps the abstract tiers agents ask for onto concrete provider model ids.
# An unmapped tier falls back to the provider default and logs a warning.
#
# The single quotes are load-bearing. scripts/dev.sh sources this file with
# `set -a; source .env`, and bash applies quote removal to an assignment's
# right-hand side, so an unquoted value reaches Node as {kimi:{deep:...}} —
# unquoted keys, not valid JSON, and the config parser refuses to boot. Tools
# reading the file through process.loadEnvFile() parse it correctly either way,
# so the failure appears only under `pnpm dev` and looks unrelated to quoting.
# MODEL_TIER_MAP='{"kimi":{"deep":"","fast":"","cheap":""},"deepseek":{"deep":"","fast":"","cheap":""}}'

# Set to 1 alongside a real key to record live responses into fixtures/model/,
# which grows the offline corpus for free.
MODEL_RECORD=0
MOCK_STREAM_JITTER_MS=12          # demo command overrides this to 0

# ── Execution safety ────────────────────────────────────────────────────────
# 1 = every tool routes to simulate() regardless of credentials. Default on in
# development so nothing reaches a real merchant account by accident.
KILN_SANDBOX=1
# SANDBOX_MODE is the deployment-facing alias; KILN_SANDBOX wins when both are set.
SANDBOX_MODE=1
DEMO_MODE=1
ENABLE_MCP_SERVER=1
MCP_PORT=3100
WORKER_POLL_MS=1000

# Hosts the egress-controlled HTTP client is permitted to reach. Private IP
# ranges and redirects out of this list are refused in every environment.
EGRESS_ALLOWLIST=api.moonshot.ai,api.deepseek.com,api.shopify.com,api.stripe.com

# ── Vault ───────────────────────────────────────────────────────────────────
# Key Encryption Key provider: `local` (libsodium + .kiln/keys) or `kms`.
KEY_PROVIDER=local
# KMS_KEY_ID=
# AWS_REGION=
# KILN_KEYFILE=.kiln/keys/kek.key

# ── Supabase (auth, storage, realtime) ──────────────────────────────────────
# Unset -> local auth stub + filesystem storage under .kiln/storage
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Billing ─────────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email ───────────────────────────────────────────────────────────────────
# RESEND_API_KEY=
EMAIL_FROM=kiln@localhost

# ── Jobs ────────────────────────────────────────────────────────────────────
# Unset -> Postgres FOR UPDATE SKIP LOCKED queue (works offline).
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
REDIS_URL=redis://localhost:6379

# ── Connectors (all optional; absent credentials force simulation) ──────────
# SHOPIFY_PARTNER_TOKEN=
# SHOPIFY_APP_KEY=
# SHOPIFY_APP_SECRET=
# VERCEL_TOKEN=
# CLOUDFLARE_API_TOKEN=
# NAMECHEAP_API_KEY=
# PRINTFUL_API_KEY=
# PRINTIFY_API_KEY=
# GELATO_API_KEY=
# CALCOM_API_KEY=
# SEARCH_API_KEY=
# IMAGE_API_KEY=

# ── Observability ───────────────────────────────────────────────────────────
# Unset -> traces print to the console.
# OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
